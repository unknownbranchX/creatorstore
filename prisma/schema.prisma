model AutoDmQueueJob {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId          String    @map("creator_id") @db.Uuid
  instagramAccountId String?   @map("instagram_account_id") @db.Uuid
  automationId       String?   @map("automation_id") @db.Uuid

  dedupeKey          String    @unique @map("dedupe_key")
  triggerType        String    @default("COMMENT") @map("trigger_type")
  commentId          String?   @map("comment_id")
  mediaId            String?   @map("media_id")
  recipientId        String?   @map("recipient_id")
  recipientUsername  String?   @map("recipient_username")

  // Message payload details
  message            String
  quickReplies       Json?     @default("[]") @map("quick_replies")
  commentReply       String?   @map("comment_reply")
  destinationUrl     String?   @map("destination_url")
  buttonText         String?   @map("button_text")

  // Job lifecycle & execution
  status             String    @default("PENDING") // PENDING, PROCESSING, RETRYING, SENT, FAILED, CANCELLED
  attemptCount       Int       @default(0) @map("attempt_count")
  maxAttempts        Int       @default(5) @map("max_attempts")
  scheduledAt        DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz
  nextAttemptAt      DateTime? @default(now()) @map("next_attempt_at") @db.Timestamptz

  // Distributed locking
  lockedAt           DateTime? @map("locked_at") @db.Timestamptz
  lockedBy           String?   @map("locked_by")
  lockExpiresAt      DateTime? @map("lock_expires_at") @db.Timestamptz

  // Results & Errors
  sentAt             DateTime? @map("sent_at") @db.Timestamptz
  failedAt           DateTime? @map("failed_at") @db.Timestamptz
  providerMessageId  String?   @map("provider_message_id")
  lastErrorCategory  String?   @map("last_error_category")
  lastErrorMessage   String?   @map("last_error_message")
  lastErrorDetails   Json?     @map("last_error_details")

  isSimulation       Boolean   @default(false) @map("is_simulation")

  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator          User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  automation       Automation?       @relation(fields: [automationId], references: [id], onDelete: SetNull)
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt, nextAttemptAt], map: "idx_auto_dm_queue_eligible")
  @@index([isSimulation, status], map: "idx_auto_dm_queue_simulation")
  @@index([creatorId, status], map: "idx_auto_dm_queue_creator_status")
  @@index([instagramAccountId, status], map: "idx_auto_dm_queue_account_status")
  @@index([lockExpiresAt], map: "idx_auto_dm_queue_lock_expires")
  @@map("auto_dm_queue_jobs")
}

model AutoDmRateLimit {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instagramAccountId String    @unique @map("instagram_account_id") @db.Uuid
