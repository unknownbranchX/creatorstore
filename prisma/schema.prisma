// ==============================================================================
// CREATORZERO PLATFORM — PRISMA SCHEMA FOR SUPABASE POSTGRESQL
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// 1. Identity & Profiles
// ------------------------------------------------------------------------------

model User {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String    @unique
  passwordHash              String    @map("password_hash")
  role                      String    @default("CREATOR")
  emailVerified             Boolean?  @default(false) @map("email_verified")
  resetTokenHash            String?   @map("reset_token_hash")
  resetTokenExpires         DateTime? @map("reset_token_expires") @db.Timestamptz
  verificationTokenHash     String?   @map("verification_token_hash")
  verificationTokenExpires  DateTime? @map("verification_token_expires") @db.Timestamptz
  country                   String?   @db.VarChar(2)
  createdAt                 DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creatorProfile      CreatorProfile?
  customers           Customer[]
  store               Store?
  storeSections       StoreSection[]
  creatorSubscription CreatorSubscription?
  products            Product[]
  checkoutFields      CheckoutFields[]
  courses             Course[]
  courseModules       CourseModule[]
  courseLessons       CourseLesson[]
  orders              Order[]
  coupons             Coupon[]
  instagramAccount    InstagramAccount?
  automations         Automation[]
  automationEvents    AutomationEvent[]
  payoutProfile       PayoutProfile?
  payoutAuditLogs     PayoutAuditLog[]
  subscriptionAuditLogs SubscriptionAuditLog[]
  subscriptionInvoices  SubscriptionInvoice[]
  supportTickets        SupportTicket[]
  forms                 Form[]
  formSubmissions       FormSubmission[]
  newsletterSubscribers NewsletterSubscriber[]
  notifications         Notification[]
  autoDmQueueJobs       AutoDmQueueJob[]
  autoDmRateLimits      AutoDmRateLimit[]

  @@map("users")
}

model CreatorProfile {
  creatorId          String    @id @map("creator_id") @db.Uuid
  name               String?
  phone              String?
  bio                String?
  category           String?
  avatarUrl          String?   @map("avatar_url")
  socialLinks        Json?     @default("{}") @map("social_links")
  onboardingStatus   String?   @default("SOCIAL_SETUP") @map("onboarding_status")
  onboardingComplete Boolean?  @default(false) @map("onboarding_complete")
  country            String?   @db.VarChar(2)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model Customer {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId  String?   @map("creator_id") @db.Uuid
  email      String
  name       String?
  phone      String?
  country    String?   @map("country")
  totalSpent Decimal?  @default(0) @map("total_spent") @db.Decimal
  ordersCount Int?     @default(0) @map("orders_count")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator          User?               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orders           Order[]
  entitlements     Entitlement[]
  courseProgress   CourseProgress[]
  certificates     CourseCertificate[]

  @@unique([creatorId, email])
  @@index([country], map: "idx_customers_country")
  @@index([creatorId, createdAt(sort: Desc)], map: "idx_customers_creator_created_at")
  @@map("customers")
}

// ------------------------------------------------------------------------------
// 2. Stores & Layouts
// ------------------------------------------------------------------------------

model Store {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId   String    @unique @map("creator_id") @db.Uuid
  username    String    @unique
  storeName   String?   @map("store_name")
  slug        String?   @unique @map("slug")
  bio         String?
  avatarUrl   String?   @map("avatar_url")
  coverUrl    String?   @map("cover_url")
  published   Boolean?  @default(false)
  theme       Json?     @default("{}")
  socialLinks Json?     @default("{}") @map("social_links")
  pages       Json?     @default("[]")  // Array of { id, name, slug, isDefault, position }
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("stores")
}

model StoreSection {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId String    @map("creator_id") @db.Uuid
  pageId    String?   @map("page_id") @db.Uuid  // null = default Home page
  type      String
  position  Int
  hidden    Boolean?  @default(false)
  props     Json?     @default("{}")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, pageId], map: "idx_store_sections_creator_page")
  @@index([creatorId, position(sort: Asc)], map: "idx_store_sections_creator_position")
  @@map("store_sections")
}

// ------------------------------------------------------------------------------
// 3. Subscriptions & Monetization
// ------------------------------------------------------------------------------

model CreatorSubscription {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId              String    @unique @map("creator_id") @db.Uuid
  plan                   String    @default("CREATOR_PRO")
  status                 String    @default("ACTIVE")
  billingInterval        String?   @default("MONTHLY") @map("billing_interval")
  amount                 Decimal?  @default(0) @db.Decimal
  currency               String?   @default("INR")
  provider               String?   @default("DODO")
  providerSubscriptionId String?   @map("provider_subscription_id")
  dodoSubscriptionId     String?   @unique @map("dodo_subscription_id")
  dodoPaymentId          String?   @map("dodo_payment_id")
  dodoCustomerId         String?   @map("dodo_customer_id")
  razorpayOrderId        String?   @unique @map("razorpay_order_id")
  razorpayPaymentId      String?   @map("razorpay_payment_id")
  currentPeriodStart     DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz
  canceledAt             DateTime? @map("canceled_at") @db.Timestamptz
  trialStartedAt         DateTime? @map("trial_started_at") @db.Timestamptz
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz
  trialStatus            String?   @default("NOT_STARTED") @map("trial_status")
  scheduledPlan          String?   @map("scheduled_plan")
  scheduledChangeAt      DateTime? @map("scheduled_change_at") @db.Timestamptz
  scheduledInterval      String?   @map("scheduled_interval")
  pendingUpgradePlan        String?   @map("pending_upgrade_plan")
  pendingUpgradeInterval    String?   @map("pending_upgrade_interval")
  pendingUpgradePaymentId   String?   @map("pending_upgrade_payment_id")
  pendingUpgradeStatus      String?   @map("pending_upgrade_status")
  pendingUpgradeStartedAt   DateTime? @map("pending_upgrade_started_at") @db.Timestamptz
  pendingUpgradeErrorMessage String?  @map("pending_upgrade_error_message")
  pendingUpgradePaymentLink String?   @map("pending_upgrade_payment_link")
  pendingUpgradeAmount      Decimal?  @map("pending_upgrade_amount") @db.Decimal
  pendingUpgradeCurrency    String?   @map("pending_upgrade_currency")
  lastVerifiedAt             DateTime? @map("last_verified_at") @db.Timestamptz
  cancellationReason         String?   @map("cancellation_reason")
  cancellationDetails        Json?     @default("{}") @map("cancellation_details")
  authStatus                 String?   @default("ACTIVE") @map("auth_status")
  lastInvoiceId              String?   @map("last_invoice_id")
  lastInvoiceStatus          String?   @map("last_invoice_status")
  lastPaymentFailureReason   String?   @map("last_payment_failure_reason")
  lastPaymentFailureAt       DateTime? @map("last_payment_failure_at") @db.Timestamptz
  gracePeriodEndsAt          DateTime? @map("grace_period_ends_at") @db.Timestamptz
  retryCount                 Int?      @default(0) @map("retry_count")
  createdAt                  DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([pendingUpgradeStatus, pendingUpgradeStartedAt], map: "idx_creator_subscriptions_pending_upgrade")
  @@index([status, authStatus], map: "idx_creator_subscriptions_status_auth")
  @@map("creator_subscriptions")
}

// ------------------------------------------------------------------------------
// 4. Products & Catalog
// ------------------------------------------------------------------------------

model Product {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId            String    @map("creator_id") @db.Uuid
  title                String
  slug                 String
  type                 String
  status               String    @default("DRAFT")
  price                Decimal   @default(0) @db.Decimal
  currency             String    @default("INR")
  shortDescription     String?   @map("short_description")
  description          String?
  coverImage           String?   @map("cover_image")
  thumbnail            String?
  fileId               String?   @map("file_id")
  fileName             String?   @map("file_name")
  fileSize             Int?      @map("file_size")
  fileMime             String?   @map("file_mime")
  storePublished       Boolean?  @default(true) @map("store_published")
  marketplacePublished Boolean?  @default(false) @map("marketplace_published")
  displayMode          String?   @default("classic") @map("display_mode")
  redirectUrl          String?   @map("redirect_url")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator          User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  checkoutFields   CheckoutFields?
  course           Course?
  orders           Order[]
  entitlements     Entitlement[]
  accessTokens     ProductAccessToken[]
  automations      Automation[]
  automationEvents AutomationEvent[]
  coupons          Coupon[]
  bundleItems      BundleItem[]      @relation("BundleToItems")
  inBundles        BundleItem[]      @relation("ProductInBundles")

  @@unique([creatorId, slug])
  @@index([creatorId, slug], map: "idx_products_creator_slug")
  @@index([creatorId, status, createdAt(sort: Desc)], map: "idx_products_creator_status_created")
  @@map("products")
}

model BundleItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bundleId  String    @map("bundle_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  position  Int       @default(0)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  bundle  Product @relation("BundleToItems", fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation("ProductInBundles", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId], map: "idx_bundle_items_bundle_product_unique")
  @@index([bundleId, position], map: "idx_bundle_items_bundle_position")
  @@map("bundle_items")
}

model Coupon {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId     String    @map("creator_id") @db.Uuid
  code          String
  type          String    @default("PERCENTAGE")
  discount      Decimal   @default(0) @db.Decimal
  scope         String    @default("ALL")
  productIds    Json?     @default("[]") @map("product_ids")
  productId     String?   @map("product_id") @db.Uuid
  minOrderPrice Decimal?  @default(0) @map("min_order_price") @db.Decimal
  validityHours Int?      @default(24) @map("validity_hours")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  expiryDate    DateTime? @map("expiry_date") @db.Timestamptz
  usageLimit    Int?      @default(0) @map("usage_limit")
  usedCount     Int?      @default(0) @map("used_count")
  status        String    @default("ACTIVE")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([creatorId, code])
  @@index([creatorId, status], map: "idx_coupons_creator_status")
  @@map("coupons")
}

model CheckoutFields {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @unique @map("product_id") @db.Uuid
  creatorId      String    @map("creator_id") @db.Uuid
  collectPhone   Boolean?  @default(false) @map("collect_phone")
  collectAddress Boolean?  @default(false) @map("collect_address")
  customFields   Json?     @default("[]") @map("custom_fields")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("checkout_fields")
}

// ------------------------------------------------------------------------------
// 5. Courses
// ------------------------------------------------------------------------------

model Course {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String?   @unique @map("product_id") @db.Uuid
  creatorId    String    @map("creator_id") @db.Uuid
  title        String
  slug         String?
  description  String?
  coverImage   String?   @map("cover_image")
  lessonsCount Int?      @default(0) @map("lessons_count")
  published    Boolean?  @default(false)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  product      Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator      User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  modules      CourseModule[]
  lessons      CourseLesson[]
  progress     CourseProgress[]
  certificates CourseCertificate[]

  @@map("courses")
}

model CourseModule {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String    @map("course_id") @db.Uuid
  creatorId String    @map("creator_id") @db.Uuid
  title     String
  position  Int       @default(0)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@map("course_modules")
}

model CourseLesson {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  moduleId      String    @map("module_id") @db.Uuid
  creatorId     String    @map("creator_id") @db.Uuid
  title         String
  type          String?   @default("VIDEO")
  content       String?
  videoUrl      String?   @map("video_url")
  attachmentUrl String?   @map("attachment_url")
  freePreview   Boolean?  @default(false) @map("free_preview")
  position      Int       @default(0)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  creator  User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  progress CourseProgress[]

  @@index([courseId, position], map: "idx_course_lessons_course_pos")
  @@map("course_lessons")
}

model CourseProgress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  completed   Boolean?  @default(true)
  completedAt DateTime? @default(now()) @map("completed_at") @db.Timestamptz
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([customerId, courseId, lessonId])
  @@map("course_progress")
}

model CourseCertificate {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateId String    @unique @map("certificate_id")
  customerId    String    @map("customer_id") @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  issuedAt      DateTime? @default(now()) @map("issued_at") @db.Timestamptz
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([customerId, courseId])
  @@map("course_certificates")
}

// ------------------------------------------------------------------------------
// 6. Orders & Entitlements
// ------------------------------------------------------------------------------

model Order {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId         String    @map("creator_id") @db.Uuid
  customerId        String?   @map("customer_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  automationId      String?   @map("automation_id") @db.Uuid
  customerName      String?   @map("customer_name")
  customerEmail     String    @map("customer_email")
  amount            Decimal   @db.Decimal
  currency          String?   @default("INR")
  originalPrice     Decimal?  @map("original_price") @db.Decimal
  originalCurrency  String?   @map("original_currency")
  presentmentAmount Decimal?  @map("presentment_amount") @db.Decimal
  presentmentCurrency String? @map("presentment_currency")
  chargedAmount     Decimal?  @map("charged_amount") @db.Decimal
  chargedCurrency   String?   @map("charged_currency")
  exchangeRate      Decimal?  @map("exchange_rate") @db.Decimal
  exchangeRateTimestamp DateTime? @map("exchange_rate_timestamp") @db.Timestamptz
  taxAmount         Decimal?  @map("tax_amount") @db.Decimal
  taxCurrency       String?   @map("tax_currency")
  status            String    @default("PENDING")
  paymentProvider   String?   @default("dodo") @map("payment_provider")
  country           String?   @default("IN") @map("country")
  dodoPaymentId     String?   @unique @map("dodo_payment_id")
  dodoSessionId     String?   @map("dodo_session_id")
  razorpayOrderId   String?   @unique @map("razorpay_order_id")
  razorpayPaymentId String?   @map("razorpay_payment_id")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator     User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  automation  Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  entitlement  Entitlement?
  accessTokens ProductAccessToken[]

  @@index([creatorId, status], map: "idx_orders_creator_status")
  @@index([creatorId, createdAt(sort: Desc)], map: "idx_orders_creator_created_at")
  @@index([creatorId, productId, status], map: "idx_orders_creator_product_status")
  @@index([automationId, status], map: "idx_orders_automation_status")
  @@index([country], map: "idx_orders_country")
  @@map("orders")
}

model Entitlement {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String?   @unique @map("order_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  customerEmail String    @map("customer_email")
  productId     String    @map("product_id") @db.Uuid
  status        String    @default("ACTIVE")
  startsAt      DateTime? @default(now()) @map("starts_at") @db.Timestamptz
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  accessTokens ProductAccessToken[]

  @@index([customerId, productId], map: "idx_entitlements_customer_product")
  @@map("entitlements")
}

model ProductAccessToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  orderId       String    @map("order_id") @db.Uuid
  entitlementId String?   @map("entitlement_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  customerEmail String    @map("customer_email")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  usedAt        DateTime? @map("used_at") @db.Timestamptz
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  entitlement Entitlement? @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "idx_product_access_tokens_hash")
  @@index([orderId], map: "idx_product_access_tokens_order")
  @@index([productId], map: "idx_product_access_tokens_product")
  @@index([customerEmail], map: "idx_product_access_tokens_email")
  @@index([expiresAt], map: "idx_product_access_tokens_expires")
  @@map("product_access_tokens")
}

// ------------------------------------------------------------------------------
// 7. Instagram Integration & Automations
// ------------------------------------------------------------------------------

model InstagramAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId      String    @unique @map("creator_id") @db.Uuid
  platform       String    @default("INSTAGRAM")
  platformUserId String?   @map("platform_user_id")
  username       String?
  accessToken    String?   @map("access_token")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz
  status         String    @default("CONNECTED")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  queueJobs AutoDmQueueJob[]
  rateLimit AutoDmRateLimit?

  @@map("instagram_accounts")
}

model Automation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId       String    @map("creator_id") @db.Uuid
