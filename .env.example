# ==============================================================================
# CREATORSTORE — COMPREHENSIVE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Complete reference of all environment variables used across the platform.
# Replace all placeholder values with your environment-specific credentials.
# NEVER commit files containing actual secrets to version control.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION CONFIGURATION
# ==============================================================================

# Node execution environment (development, test, production)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to development in Next.js
NODE_ENV=development

# Canonical public application base URL for links, redirects, and CORS
# [REQUIRED | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Exposed to client bundle. Must be production domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side fallback for canonical application base URL
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback behind NEXT_PUBLIC_APP_URL in config/site.js
APP_URL=http://localhost:3000

# Secondary fallback for public application base URL
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Fallback behind NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Tertiary fallback for public application base URL
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Referenced in config/site.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local server HTTP listening port
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Used in test server scripts, defaults to 3000
PORT=3000

# Base URL override used by Python and shell integration tests
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Referenced in backend_test.py and tests/*.py
BASE_URL=http://localhost:3000

# Test suite target application URL
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Used in E2E tests for test target routing
TEST_APP_URL=http://localhost:3000

# Railway deployment environment detector (production, staging)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Automatically provided by Railway cloud environment
RAILWAY_ENVIRONMENT=production

# Vercel deployment environment detector (production, preview)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Automatically provided by Vercel environment
VERCEL_ENV=production

# ==============================================================================
# 2. DATABASE AND PRISMA
# ==============================================================================

# PostgreSQL connection string with connection pooling (e.g. Supabase pgbouncer / Supavisor)
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Used by Prisma client runtime for application queries
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct PostgreSQL connection string (session-mode port 5432) for Prisma migrations
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Required by Prisma for migrations and DDL
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ==============================================================================
# 3. AUTHENTICATION AND SECURITY
# ==============================================================================

# Cryptographic secret key used to sign and verify user session JWTs
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Must be >= 32 characters in production (enforced in lib/auth.js)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# Forces Secure attribute on auth cookies (true for HTTPS, false for local HTTP testing)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to true when NODE_ENV === production
COOKIE_SECURE=true

# Google OAuth 2.0 Web Application Client ID (from Google Cloud Console)
# [REQUIRED FOR GOOGLE AUTH | SERVER-ONLY | NON-SENSITIVE] - Used for Native Google OAuth 2.0 login and registration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google OAuth 2.0 Web Application Client Secret (from Google Cloud Console)
# [REQUIRED FOR GOOGLE AUTH | SERVER-ONLY | SENSITIVE (SECRET)] - Used to exchange authorization code for access tokens
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional explicit redirect URI override for Google OAuth callback
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_REDIRECT_URI=https://creatorstore.store/api/auth/callback/google

# Optional client-side exposed Google Client ID
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Optional mirror of GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Comma-separated allowed origins for Cross-Origin Resource Sharing
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Parsed in lib/cors.js and next.config.js
CORS_ORIGINS=https://creatorstore.store,https://www.creatorstore.store,http://localhost:3000

# Time-to-live in minutes for guest purchase download OTPs
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 10 minutes in lib/purchaseOtpService.js
OTP_EXPIRY_MINUTES=10

# Maximum invalid verification attempts allowed before OTP invalidation
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 5 attempts in lib/purchaseOtpService.js
OTP_MAX_ATTEMPTS=5

# Cooldown in seconds before requesting a new verification OTP
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 60 seconds in lib/purchaseOtpService.js
OTP_RESEND_COOLDOWN_SECONDS=60

# Session lifetime in minutes for authorized guest download access
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 30 minutes in lib/purchaseOtpService.js
PURCHASE_ACCESS_SESSION_MINUTES=30

# ==============================================================================
# 4. SUPABASE
# ==============================================================================

# Supabase project HTTPS API endpoint
# [REQUIRED | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Public endpoint used by both client and server SDKs
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Supabase anonymous public API key for browser access
# [REQUIRED | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - RLS-protected public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase modern publishable API key format
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Configured in .env for modern Supabase client compatibility
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase service-role administrative key for server-only operations
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Bypasses RLS. NEVER expose to frontend or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# 5. RAZORPAY
# ==============================================================================

# Razorpay operational mode: test or live
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Determines validation rules and API endpoint behavior
RAZORPAY_MODE=test

# Alias for RAZORPAY_MODE (test or live)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback read in lib/payments.js
RAZORPAY_ENV=test

# Enables mock payment simulation mode for offline testing
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Used in development/testing only
RAZORPAY_MOCK=false

# Razorpay API Key ID (server-side)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Must start with rzp_test_ (in test) or rzp_live_ (in prod)
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay API Key ID exposed to frontend checkout modal
# [REQUIRED | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Must match RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay API Key Secret for authenticated server-side API requests
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Server-only credential. Never expose to client.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Secret token used to verify HMAC-SHA256 signatures on Razorpay webhooks
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Server-only secret configured in Razorpay Dashboard Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay Plan ID for monthly Creator Plan in INR (₹499/mo)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Recurring mandate subscription plan
RAZORPAY_CREATOR_PLAN_ID=plan_creator_inr_monthly

# Legacy fallback alias for RAZORPAY_CREATOR_PLAN_ID
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback in lib/plans.js and lib/entitlement-service.js
RAZORPAY_STARTER_PLAN_ID=plan_creator_inr_monthly

# Razorpay Plan ID for annual Creator Plan in INR (₹4,790/yr)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Annual recurring subscription plan
RAZORPAY_CREATOR_ANNUAL_PLAN_ID=plan_creator_inr_annual

# Razorpay Plan ID for monthly Pro Plan in INR (₹999/mo)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Recurring mandate subscription plan
RAZORPAY_PRO_PLAN_ID=plan_pro_inr_monthly

# Razorpay Plan ID for annual Pro Plan in INR (₹9,590/yr)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Annual recurring subscription plan
RAZORPAY_PRO_ANNUAL_PLAN_ID=plan_pro_inr_annual

# Razorpay Plan ID for USD monthly Creator plan ($6/mo)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Optional USD recurring plan in lib/billing/config.js
RAZORPAY_CREATOR_USD_PLAN_ID=plan_creator_usd_monthly

# Razorpay Plan ID for USD annual Creator plan ($58/yr)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Optional USD recurring plan in lib/billing/config.js
RAZORPAY_CREATOR_USD_ANNUAL_PLAN_ID=plan_creator_usd_annual

# Razorpay Plan ID for USD monthly Pro plan ($12/mo)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Optional USD recurring plan in lib/billing/config.js
RAZORPAY_PRO_USD_PLAN_ID=plan_pro_usd_monthly

# Razorpay Plan ID for USD annual Pro plan ($115/yr)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Optional USD recurring plan in lib/billing/config.js
RAZORPAY_PRO_USD_ANNUAL_PLAN_ID=plan_pro_usd_annual

# Timeout in minutes before an unauthenticated subscription checkout is marked abandoned
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 60 minutes in lib/razorpay-subscription-lifecycle.js
RAZORPAY_PENDING_SUBSCRIPTION_TIMEOUT_MINUTES=60

# Grace period in days allowed for failed renewal payments before account suspension
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 3 days in lib/razorpay-subscription-lifecycle.js
RAZORPAY_SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Currency code for Razorpay subscriptions
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Configured in .env, defaults to INR
RAZORPAY_SUBSCRIPTION_CURRENCY=INR

# ==============================================================================
# 6. DODO PAYMENTS
# ==============================================================================

# Dodo Payments mode: test_mode or live_mode
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Enforces live vs test API endpoints
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Alias for DODO_PAYMENTS_ENVIRONMENT
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback in lib/dodo.js
DODO_ENVIRONMENT=test_mode

# Dodo Payments Bearer API Key for creating checkout sessions and managing payments
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Server-only secret key
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here

# Alias for DODO_PAYMENTS_API_KEY
# [OPTIONAL | SERVER-ONLY | SENSITIVE (SECRET)] - Fallback in lib/dodo.js
DODO_API_KEY=your_dodo_api_key_here

# Dodo Payments webhook secret (standardwebhooks format whsec_...)
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Used to cryptographically verify incoming payment webhooks
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_key_here

# Alias for DODO_PAYMENTS_WEBHOOK_KEY
# [OPTIONAL | SERVER-ONLY | SENSITIVE (SECRET)] - Fallback in lib/dodo.js
DODO_WEBHOOK_SECRET=whsec_your_dodo_webhook_key_here

# TTL in minutes before pending/unpaid Dodo checkout sessions are expired
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 30 minutes in lib/dodo.js
DODO_PENDING_PAYMENT_TTL_MINUTES=30

# Explicit base URL override for Dodo post-checkout return redirects
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Optional override in lib/dodo.js
DODO_RETURN_URL_BASE=http://localhost:3000

# Alias for DODO_RETURN_URL_BASE
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback in lib/dodo.js
DODO_BASE_URL=http://localhost:3000

# Explicit full return URL for successful Dodo checkout sessions
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Optional override in lib/dodo.js
DODO_RETURN_URL=http://localhost:3000/api/creator/subscription/dodo/return

# Redirect URL if a customer cancels a Dodo checkout session
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to billing settings page with canceled=true
DODO_CANCEL_URL=http://localhost:3000/dashboard/settings/billing?canceled=true

# Dodo Product ID for Creator plan monthly USD ($6/mo)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - International monthly recurring product
DODO_PRODUCT_CREATOR_MONTHLY_ID=p_creator_monthly

# Dodo Product ID for Creator plan annual USD ($58/yr)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - International annual recurring product
DODO_PRODUCT_CREATOR_ANNUAL_ID=p_creator_annual

# Dodo Product ID for Creator plan monthly INR (₹499/mo)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Domestic India monthly product via Dodo
DODO_PRODUCT_CREATOR_INR_MONTHLY_ID=p_creator_inr_monthly

# Dodo Product ID for Creator plan annual INR (₹4,790/yr)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Domestic India annual product via Dodo
DODO_PRODUCT_CREATOR_INR_ANNUAL_ID=p_creator_inr_annual

# Dodo Product ID for Pro plan monthly USD ($12/mo)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - International monthly recurring product
DODO_PRODUCT_PRO_MONTHLY_ID=p_pro_monthly

# Dodo Product ID for Pro plan annual USD ($115/yr)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - International annual recurring product
DODO_PRODUCT_PRO_ANNUAL_ID=p_pro_annual

# Dodo Product ID for Pro plan monthly INR (₹999/mo)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Domestic India monthly product via Dodo
DODO_PRODUCT_PRO_INR_MONTHLY_ID=p_pro_inr_monthly

# Dodo Product ID for Pro plan annual INR (₹9,590/yr)
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Domestic India annual product via Dodo
DODO_PRODUCT_PRO_INR_ANNUAL_ID=p_pro_inr_annual

# ==============================================================================
# 7. EMAIL AND RESEND
# ==============================================================================

# Resend API key (re_...) for transactional email delivery over HTTPS
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Server-only secret. Replaces legacy SMTP.
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address for platform outgoing transactional emails
# [REQUIRED | SERVER-ONLY | NON-SENSITIVE] - Must use verified sender domain on Resend
EMAIL_FROM="CreatorStore <hello@creatorstore.store>"

# Alias for EMAIL_FROM
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Used in existing .env.example
FROM_EMAIL="CreatorStore <hello@creatorstore.store>"

# Reply-To header for transactional emails
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to SUPPORT_EMAIL if not set
EMAIL_REPLY_TO=support@creatorstore.store

# Platform primary support email address
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Used in email templates and customer notifications
SUPPORT_EMAIL=support@creatorstore.store

# Support email exposed to storefront and client UI
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Client-accessible support contact
NEXT_PUBLIC_SUPPORT_EMAIL=support@creatorstore.store

# Target inbox address when running live email delivery test scripts
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Used in scripts/test_resend_live.js and scripts/test_email_delivery.js
TEST_EMAIL_RECIPIENT=dev@yourdomain.com

# ==============================================================================
# 8. OPENAI AND AI SERVICES
# ==============================================================================

# Note: CreatorStore currently does not use active OpenAI/AI API keys in runtime code.
# Reserved for future AI integrations:
# OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# 9. INSTAGRAM AND META
# ==============================================================================

# Meta / Facebook Application ID for Instagram Graph API OAuth & Webhooks
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Required for live Instagram integration
META_INSTAGRAM_APP_ID=your_meta_app_id

# Alias for META_INSTAGRAM_APP_ID
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback in lib/services.js
META_APP_ID=your_meta_app_id

# Meta App ID exposed to client-side Facebook SDK
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Fallback in lib/services.js
NEXT_PUBLIC_META_APP_ID=your_meta_app_id

# Meta Application Secret for token exchange and HMAC signature verification
# [OPTIONAL | SERVER-ONLY | SENSITIVE (SECRET)] - Server-only secret
META_INSTAGRAM_APP_SECRET=your_meta_app_secret

# Alias for META_INSTAGRAM_APP_SECRET
# [OPTIONAL | SERVER-ONLY | SENSITIVE (SECRET)] - Fallback in lib/services.js and app/api/[[...path]]/route.js
META_APP_SECRET=your_meta_app_secret

# OAuth redirect callback URL for Instagram Creator authorization
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Must match Allowed Redirect URIs in Meta App Dashboard
META_INSTAGRAM_REDIRECT_URI=https://creatorstore.store/api/integrations/instagram/callback

# Alias for META_INSTAGRAM_REDIRECT_URI
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback in lib/services.js
META_REDIRECT_URI=https://creatorstore.store/api/integrations/instagram/callback

# Shared verification token for Meta Webhook subscription handshakes
# [OPTIONAL | SERVER-ONLY | SENSITIVE (SECRET)] - Configured in Meta App Dashboard Webhook settings
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token

# Alias for META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN
# [OPTIONAL | SERVER-ONLY | SENSITIVE (SECRET)] - Fallback in app/api/[[...path]]/route.js
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token

# Alias for META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN
# [OPTIONAL | SERVER-ONLY | SENSITIVE (SECRET)] - Fallback in app/api/[[...path]]/route.js
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token

# Target version of the Meta Graph API
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to v21.0 in lib/meta-api-client.js
META_API_VERSION=v21.0

# Simulates Meta OAuth tokens and API responses without calling external Meta servers
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Used in test and local staging
META_TEST_MODE=false

# ==============================================================================
# 10. AUTO-DM WORKER
# ==============================================================================

# Unique identifier for the running worker process instance for atomic job claiming
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to worker-{pid}-{timestamp}
WORKER_ID=worker-instance-1

# Polling idle interval in milliseconds between database queue scans
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 1500ms in scripts/auto-dm-worker.js
AUTO_DM_POLL_INTERVAL_MS=1500

# Maximum number of queue jobs claimed per polling cycle
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 5 jobs in scripts/auto-dm-worker.js
AUTO_DM_BATCH_SIZE=5

# Processes queue jobs in simulation mode without calling Meta Instagram Send APIs
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to false
AUTO_DM_SIMULATION_MODE=false

# Processes both real and simulated queue jobs in a single worker
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Optional override in scripts/auto-dm-worker.js
AUTO_DM_PROCESS_ALL=false

# Dispatches private reply Auto-DMs synchronously upon receiving webhook trigger
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to false (asynchronous queue worker)
AUTO_DM_SYNC_SEND=false

# ==============================================================================
# 11. ANALYTICS
# ==============================================================================

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Loaded client-side in lib/analytics.ts
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID (GTM-XXXXXXX)
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Loaded in app/layout.js
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Toggles Google Analytics and GTM script loading in client browser
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Defaults to true if GTM_ID or GA_MEASUREMENT_ID is provided
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Enables verbose console logging for client-side analytics events
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Development / debugging flag
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# ==============================================================================
# 12. FILE STORAGE
# ==============================================================================

# CreatorStore utilizes Supabase Object Storage (e.g. buckets: 'creator-assets', 'product-files').
# Storage operations authenticate using NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (defined in section 4).
# NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://[PROJECT_REF].supabase.co/storage/v1

# ==============================================================================
# 13. CRON AND BACKGROUND JOBS
# ==============================================================================

# Bearer token used to authenticate scheduled Vercel/Railway cron jobs and health triggers
# [REQUIRED | SERVER-ONLY | SENSITIVE (SECRET)] - Protects /api/cron/* endpoints against unauthorized execution
CRON_SECRET=your_super_secure_cron_secret_min_32_characters

# ==============================================================================
# 14. PRICING & OTHER INTEGRATIONS
# ==============================================================================

# Base monthly price for Creator plan in USD ($6)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 6 in lib/billing/config.js
CREATOR_PLAN_PRICE=6

# Base monthly price for Creator plan in INR (₹499)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 499 in lib/plans.js
CREATOR_PLAN_PRICE_INR=499

# Alias for CREATOR_PLAN_PRICE_INR
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback in lib/plans.js
CREATOR_PRICE_INR=499

# Legacy alias for CREATOR_PLAN_PRICE_INR
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback in lib/plans.js
STARTER_PRICE_INR=499

# Client-exposed Creator plan monthly price in INR
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Displayed on public pricing pages
NEXT_PUBLIC_CREATOR_PLAN_PRICE_INR=499

# Legacy client-exposed alias for Creator plan monthly price
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Fallback in lib/plans.js
NEXT_PUBLIC_STARTER_PRICE_INR=499

# Base monthly price for Pro plan in USD ($12)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 12 in lib/billing/config.js
PRO_PLAN_PRICE=12

# Base monthly price for Pro plan in INR (₹999)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 999 in lib/plans.js
PRO_PLAN_PRICE_INR=999

# Alias for PRO_PLAN_PRICE_INR
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Fallback in lib/plans.js
PRO_PRICE_INR=999

# Client-exposed Pro plan monthly price in INR
# [OPTIONAL | CLIENT-EXPOSED (NEXT_PUBLIC_) | NON-SENSITIVE] - Displayed on public pricing pages
NEXT_PUBLIC_PRO_PLAN_PRICE_INR=999

# Platform commission fee percentage deducted from creator sales
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to 0% in lib/payments.js
PLATFORM_FEE_PERCENTAGE=0

# External REST API endpoint for retrieving live multi-currency exchange rates
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Defaults to open.er-api.com in lib/currencies.js
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# PayPal Plan ID for monthly Creator plan (Legacy / Inactive)
# [OPTIONAL | SERVER-ONLY | NON-SENSITIVE] - Legacy PayPal integration in lib/billing/config.js
PAYPAL_CREATOR_MONTHLY_PLAN_ID=P-06L05256BW4479128NLFBZCA

